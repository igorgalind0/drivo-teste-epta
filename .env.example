# Copie para .env na raiz e preencha. O docker-compose lê este arquivo.

# Banco de dados
POSTGRES_USER=drivo
POSTGRES_PASSWORD=drivo
POSTGRES_DB=drivo

# Autenticação — troque por uma string longa e aleatória
JWT_SECRET=troque-esta-chave-por-uma-string-longa-e-aleatoria
JWT_EXPIRES_IN=7d

# Gemini — gere uma chave gratuita em https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
