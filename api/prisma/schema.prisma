generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  firstName    String
  lastName     String
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  vehicles     Vehicle[]

  @@map("users")
}

enum FuelType {
  GASOLINA
  ETANOL
  FLEX
  DIESEL
  HIBRIDO
  ELETRICO
  GNV
}

enum VehicleType {
  AUTOMOVEL
  MOTOCICLETA
  CAMINHONETE
  UTILITARIO
  CAMINHAO
  OUTRO
}

model Vehicle {
  id              String      @id @default(uuid())
  plate           String
  renavam         String
  chassis         String
  brand           String
  model           String
  manufactureYear Int
  modelYear       Int
  color           String
  fuel            FuelType
  type            VehicleType
  nickname        String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Uma mesma placa não pode aparecer duas vezes na garagem do mesmo usuário
  @@unique([userId, plate])
  @@index([userId])
  @@map("vehicles")
}